{
  "name": "@ridgeline/map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small interactive map viewport for TypeScript applications.",
  "files": ["dist", "README.md", "docs/performance.md"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/ridgeline.js" },
    "./style.css": "./dist/ridgeline.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite --config vite.playground.config.ts --host 127.0.0.1",
    "dev:controls": "pnpm --dir control-lab dev",
    "build:controls": "pnpm --dir control-lab build",
    "test:controls": "pnpm --dir control-lab test",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:playground": "pnpm build && vite build --config vite.playground.config.ts",
    "check": "pnpm check:tickets && tsc --noEmit && pnpm --dir control-lab typecheck",
    "check:tickets": "node scripts/check-tickets.mjs",
    "test": "node --import tsx --test tests/*.test.ts scripts/*.test.mjs && pnpm test:controls",
    "test:browser": "node scripts/test-browser.mjs",
    "test:playground:browser": "playwright test -c playwright.playground.config.mjs",
    "test:controls:browser": "playwright test -c control-lab/playwright.config.ts",
    "validate": "pnpm check && pnpm test && pnpm test:browser && pnpm test:playground:browser && pnpm test:controls:browser && pnpm build:playground && pnpm build:controls",
    "measure": "node scripts/bundle-size.mjs",
    "measure:models": "node scripts/measure-models.mjs",
    "test:measurement": "node --import tsx --test tools/model-measurement/*.test.ts && node --test tools/model-measurement/instrumentation.test.mjs"
  },
  "dependencies": { "maplibre-gl": "6.11.0", "@maplibre/maplibre-gl-style-spec": "26.4.4", "@types/geojson": "7946.0.16" },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "sidc-kit": "0.3.2",
    "playwright": "^1.63.0",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "packageManager": "pnpm@11.0.9"
}
